<mujoco model="reacher_arm">
  <compiler angle="radian" inertiafromgeom="true"/>
  <default>
    <joint armature="0.05" damping="1.0" limited="true"/>
    <geom contype="0" conaffinity="0" friction="1 0.1 0.1" rgba="0.7 0.5 0.3 1"/>
  </default>
  <option timestep="0.01" gravity="0 0 0" integrator="RK4"/>

  <worldbody>
    <light diffuse="0.8 0.8 0.8" pos="0 0 3" dir="0 0 -1"/>
    <geom name="ground" type="plane" pos="0 0 -0.01" size="1 1 0.01" rgba="0.9 0.9 0.9 1" contype="0" conaffinity="0"/>

    <!-- Base of the arm, fixed at origin -->
    <body name="link0" pos="0 0 0">
      <geom name="base" type="cylinder" size="0.03 0.02" rgba="0.3 0.3 0.3 1"/>

      <!-- Link 1: shoulder -->
      <body name="link1" pos="0 0 0">
        <joint name="shoulder" type="hinge" axis="0 0 1" range="-3.1416 3.1416" pos="0 0 0"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0.1 0 0" size="0.01"/>

        <!-- Link 2: elbow, attached at end of link 1 -->
        <body name="link2" pos="0.1 0 0">
          <joint name="elbow" type="hinge" axis="0 0 1" range="-3.1416 3.1416" pos="0 0 0"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.1 0 0" size="0.01"/>

          <!-- End effector marker -->
          <body name="end_effector" pos="0.1 0 0">
            <geom name="ee_geom" type="sphere" size="0.015" rgba="0.1 0.4 0.9 1"/>
            <site name="ee_site" pos="0 0 0" size="0.005"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Target: a free-floating marker the arm must reach. Not part of the
         kinematic chain -- it has no joints affecting the arm, only visual
         and distance-computation relevance. -->
    <body name="target" pos="0.15 0.1 0">
      <geom name="target_geom" type="sphere" size="0.015" rgba="0.9 0.2 0.2 0.6" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0" size="0.005"/>
    </body>
  </worldbody>

  <actuator>
    <motor joint="shoulder" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
    <motor joint="elbow" gear="10" ctrlrange="-1 1" ctrllimited="true"/>
  </actuator>
</mujoco>
